{
    "geode": "5.1.0",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "id": "km7dev.cosmic_clones",
    "name": "Cosmic Clones",
    "version": "v1.2.2",
    "developer": "km7dev",
    "description": "Adds chasers to levels.",
    "dependencies": {
        "geode.node-ids": ">=v1.22.0",
        "razoom.save_level_data_api": ">=1.0.5",
        "alphalaneous.editortab_api": ">=2.0.7",
        "undefined0.icon_ninja": {
            "version": ">=1.4.3",
            "required": false
        }
    },
    "tags": [
        "gameplay",
        "modtober25"
    ],
    "links": {
        "source": "https://github.com/kingminer7/cosmic-clones"
    },
    "settings": {
        "enabled": {
            "name": "Enabled",
            "description": "A soft toggle for the mod. Requires reentering any active level.",
            "type": "bool",
            "default": true
        },
        "gameplay-header": {
            "type": "title",
            "name": "Gameplay Options"
        },
        "spawn-delay": {
            "name": "Initial Delay",
            "description": "Delay between the player spawning and the clones spawning. <cy>This is recommended to be higher than the main delay.</c>",
            "type": "float",
            "default": 1.5,
            "min": 0.25,
            "max": 20,
            "control": {
                "slider": true,
                "slider-step": 0.25,
                "arrows": true,
                "arrow-step": 0.25,
                "big-arrows": true,
                "big-arrow-step": 1
            }
        },
        "delay": {
            "name": "Delay",
            "description": "Delay between cosmic clones spawn.",
            "type": "float",
            "default": 1,
            "min": 0.25,
            "max": 20,
            "control": {
                "slider": true,
                "slider-step": 0.25,
                "arrows": true,
                "arrow-step": 0.25,
                "big-arrows": true,
                "big-arrow-step": 1
            }
        },
        "normal-mode": {
            "name": "Enable in Normal Mode",
            "description": "If clones should spawn in normal mode.",
            "type": "bool",
            "default": false
        },
        "editor": {
            "name": "Enable in Editor",
            "description": "If clones should spawn in the editor.",
            "type": "bool",
            "default": false
        },
        "friendly": {
            "name": "No Damage",
            "description": "Prevents clones from damaging you.\nSuggested by DragosDobrican.",
            "type": "bool",
            "default": false
        },
        "clones": {
            "name": "Clone Count",
            "description": "How many clones can spawn.",
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 20,
            "control": {
                "slider": true,
                "slider-step": 1,
                "arrows": true,
                "arrow-step": 1
            }
        },
        "style-header": {
            "type": "title",
            "name": "Style Options"
        },
        "styles": {
            "type": "custom:clone-style",
            "name": "Clone Style",
            "description": "How the clones should look.\n **<cy>This only recolors the icon (or applies a shader). This does not change the icon from your current icon.**\nSelecting multiple styles suggested by NonCloud9.",
            "default": [
                {
                    "type": "Cosmic Mario\n(SMG 1)"
                }
            ]
        },
        "sfx": {
            "name": "Sound Effects Enabled",
            "description": "If clones should play sound effects (if the selected style has any)\nToggle suggested by Crafty-Jumper.",
            "type": "bool",
            "default": true
        }
    },
    "resources": {
        "files": [
            "resources/audio/*/*"
        ],
        "sprites": [
            "resources/sprites/cosmic.png",
            "resources/sprites/normal.png",
            "resources/sprites/star.png"
        ],
        "spritesheets": {
            "CloneSheet01": [
                "resources/sprites/cube_1.png",
                "resources/sprites/triggerInner.png",
                "resources/sprites/triggerOutline.png",
                "resources/sprites/triggerMain.png"
            ]
        }
    }
}
