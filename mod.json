{
  "geode": "4.9.0",
  "gd": {
    "win": "2.2074",
    "android": "2.2074",
    "mac": "2.2074",
    "ios": "2.2074"
  },
  "id": "km7dev.cosmic_clones",
  "name": "Cosmic Clones",
  "version": "v1.0.5",
  "developer": "km7dev",
  "description": "Adds chasers to levels.",
  "dependencies": {
    "geode.node-ids": ">=v1.20.0"
  },
  "tags": [
    "gameplay",
    "modtober25"
  ],
  "links": {
    "source": "https://github.com/kingminer7/cosmic-clones"
  },
  "settings": {
    "enabled": {
      "name": "Enabled",
      "description": "A soft toggle for the mod. Requires reentering any active level.",
      "type": "bool",
      "default": true
    },
    "spawn-delay": {
      "name": "Initial Delay",
      "description": "Delay between the player spawning and the clones spawning. <cy>This is recommended to be higher than the main delay.</c>",
      "type": "float",
      "default": 1.5,
      "min": 0.25,
      "max": 20,
      "control": {
        "slider": true,
        "slider-step": 0.25,
        "arrows": true,
        "arrow-step": 0.25,
        "big-arrows": true,
        "big-arrow-step": 1
      }
    },
    "delay": {
      "name": "Delay",
      "description": "Delay between cosmic clones spawn.",
      "type": "float",
      "default": 1,
      "min": 0.25,
      "max": 20,
      "control": {
        "slider": true,
        "slider-step": 0.25,
        "arrows": true,
        "arrow-step": 0.25,
        "big-arrows": true,
        "big-arrow-step": 1
      }
    },
    "normal-mode": {
      "name": "Enable in Normal Mode",
      "description": "If clones should spawn in normal mode.",
      "type": "bool",
      "default": false
    },
    "friendly": {
      "name": "No Damage",
      "description": "Prevents clones from damaging you.\nSuggested by DragosDobrican.",
      "type": "bool",
      "default": false
    },
    "clones": {
      "name": "Clone Count",
      "description": "How many clones can spawn.",
      "type": "int",
      "default": 3,
      "min": 1,
      "max": 20,
      "control": {
        "slider": true,
        "slider-step": 1,
        "arrows": true,
        "arrow-step": 1
      }
    },
    "style-header": {
      "type": "title",
      "name": "Style Options"
    },
    "styles": {
      "type": "custom:clone-style",
      "name": "Clone Style",
      "description": "How the clones should look.\n **<cy>This only recolors the icon (or applies a shader). This does not change the icon from your current icon.**\nSelecting multiple styles suggested by NonCloud9.",
      "default": [
        {
          "type": "Cosmic Mario\n(SMG 1)"
        }
      ]
    },
    "sfx": {
      "name": "Sound Effects Enabled",
      "description": "If clones should play sound effects (if the selected style has any)\nToggle suggested by Crafty-Jumper.",
      "type": "bool",
      "default": true
    }
  },
  "resources": {
    "files": [
      "resources/audio/*/*"
    ],
    "sprites": [
      "resources/sprites/*.png"
    ]
  }
}
